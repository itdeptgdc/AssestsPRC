PORT=4000
# PostgreSQL connection. The database (assetqr_db) is created automatically on first start
# if the user has CREATEDB permission (the default "postgres" superuser does).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/assetqr_db
JWT_SECRET=please-change-this-long-random-secret
JWT_EXPIRES=7d
UPLOAD_DIR=./uploads
# First admin account (created only when the users table is empty)
ADMIN_NAME=Administrator
ADMIN_EMAIL=assestsadmin@gmail.com
ADMIN_PASSWORD=password
